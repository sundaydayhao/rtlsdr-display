set(CMAKE_SYSTEM_NAME Linux)

if(NOT DEFINED ENV{RPI_BUILDROOT_HOST})
    message(FATAL_ERROR "Please set RPI_BUILDROOT_HOST to the Buildroot host directory, for example /opt/raspberrypi-buildroot/output/host")
endif()

set(BUILDROOT_HOST "$ENV{RPI_BUILDROOT_HOST}")
set(RPI_TOOLCHAIN_TRIPLET "$ENV{RPI_TOOLCHAIN_TRIPLET}")
set(RPI_SYSTEM_PROCESSOR "$ENV{RPI_SYSTEM_PROCESSOR}")

if(RPI_TOOLCHAIN_TRIPLET STREQUAL "")
    set(RPI_TOOLCHAIN_TRIPLET "aarch64-buildroot-linux-gnu")
endif()

if(RPI_SYSTEM_PROCESSOR STREQUAL "")
    set(RPI_SYSTEM_PROCESSOR "aarch64")
endif()

set(CMAKE_SYSTEM_PROCESSOR "${RPI_SYSTEM_PROCESSOR}")
set(CMAKE_SYSROOT "${BUILDROOT_HOST}/${RPI_TOOLCHAIN_TRIPLET}/sysroot")
set(CMAKE_C_COMPILER "${BUILDROOT_HOST}/bin/${RPI_TOOLCHAIN_TRIPLET}-gcc")
set(CMAKE_CXX_COMPILER "${BUILDROOT_HOST}/bin/${RPI_TOOLCHAIN_TRIPLET}-g++")

set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "${BUILDROOT_HOST}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_PREFIX_PATH
    "${CMAKE_SYSROOT}/usr"
    "${BUILDROOT_HOST}/${RPI_TOOLCHAIN_TRIPLET}/sysroot/usr"
)
