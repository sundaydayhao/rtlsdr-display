set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED ENV{RK3566_BUILDROOT_HOST})
    message(FATAL_ERROR "Please set RK3566_BUILDROOT_HOST to the Buildroot host directory, for example /opt/rk3566-buildroot/output/host")
endif()

set(BUILDROOT_HOST "$ENV{RK3566_BUILDROOT_HOST}")
set(CMAKE_SYSROOT "${BUILDROOT_HOST}/aarch64-buildroot-linux-gnu/sysroot")
set(CMAKE_C_COMPILER "${BUILDROOT_HOST}/bin/aarch64-buildroot-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${BUILDROOT_HOST}/bin/aarch64-buildroot-linux-gnu-g++")

set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "${BUILDROOT_HOST}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_PREFIX_PATH
    "${CMAKE_SYSROOT}/usr"
    "${BUILDROOT_HOST}/aarch64-buildroot-linux-gnu/sysroot/usr"
)
