# export RTLSDR_RECORD_DIRECT_SAMPLING=0

# Used as the initial map center until the first aircraft position is decoded.
export RTLSDR_PANEL_LAT=31.2304
export RTLSDR_PANEL_LON=121.4737
export RTLSDR_PANEL_MAP_AUTO_CENTER=1
